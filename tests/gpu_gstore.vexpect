// gpu_gstore.s, one line per VGPR, lane 0 first.
//
// Worked out from sections 1.2 and 4.8 and the data file's rule that the byte
// at address a holds a & 0xff:
//
//   v2, v3   0x1000+lane, stored to 2048+4*lane and read straight back
//   v4       0x7700+lane in every lane, but only lanes 0..7 stored it
//   v5       what came back from 2560+4*lane: the stored word in lanes 0..7
//            and the untouched data file in lanes 8..15
//   v6       0x5555 poison, overwritten by the load only in the odd lanes
//   v9       the word at 3072+4*lane with byte 1 replaced by 0xaa+lane and
//            bytes 0, 2 and 3 exactly as the data file left them
//
// v8 and v10..v15 are never written and must still read zero.
00000000 00000001 00000002 00000003 00000004 00000005 00000006 00000007 00000008 00000009 0000000a 0000000b 0000000c 0000000d 0000000e 0000000f // v0

// gpu_gwide.s, one line per VGPR, lane 0 first.
//
// The data file's rule is that the byte at address a holds a & 0xff, so the
// sixteen bytes lane l loads are the words at 16*lane + 4j, j = 0..3.
//
//   v4..v7     what v_ld16_g brought back from the bottom of memory
//   v8..v11    region 2560 after a v_st16_g with exec = 0x00f0: lanes 4..7
//              hold the stored quad, every other lane still holds the data
//              file, which is what a store ignoring the exec mask destroys
//   v12..v15   a poisoned quad after a v_ld16_g with exec = 0x00f0: lanes
//              4..7 hold what the round trip wrote to region 2048, every
//              other lane still holds 0x1111/0x2222/0x3333/0x4444
//
// v2 and v3 are never written and must still read zero.
00000000 00000001 00000002 00000003 00000004 00000005 00000006 00000007 00000008 00000009 0000000a 0000000b 0000000c 0000000d 0000000e 0000000f // v0
00000000 00000010 00000020 00000030 00000040 00000050 00000060 00000070 00000080 00000090 000000a0 000000b0 000000c0 000000d0 000000e0 000000f0 // v1
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 // v2
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 // v3

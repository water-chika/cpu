// gpu16 scalar unit: the section 4.3 register-register ALU.
//
// Hand encoded against docs/gpu_isa.md section 4.1:
//
//   |1f .. 18|17 .. 14|13 .. 10|f .. c|b .. 8|7 .. 0|
//   | Opcode |  Arg0  |  Arg1  | Arg2 | Arg3 |  Mod |
//
// Launched with s0 = 0x1000, group_id_x = 7, group_id_y = 9, so this also
// pins down section 4.12's launch state.
//
//        opcode           s3 = 5
0c300005 // s_imm  s3, 5
0c400003 // s_imm  s4, 3
00534000 // s_and  s5,  s3, s4      5 & 3  = 1
01634000 // s_or   s6,  s3, s4      5 | 3  = 7
03734000 // s_xor  s7,  s3, s4      5 ^ 3  = 6
04834000 // s_add  s8,  s3, s4      5 + 3  = 8
06934000 // s_sub  s9,  s3, s4      5 - 3  = 2
09a34000 // s_mul  s10, s3, s4      5 * 3  = 15
02b30000 // s_not  s11, s3          ~5     = fffffffa
08c30000 // s_neg  s12, s3          -5     = fffffffb
0bd30000 // s_mov  s13, s3                 = 5
17e34000 // s_min  s14, s3, s4      min    = 3
18f34000 // s_max  s15, s3, s4      max    = 5
b3000000 // s_endpgm

// gpu16 scalar unit: the section 4.3 immediate forms and the shifts.
//
// Immediate-form instructions reinterpret {Arg2, Arg3, Mod} as one signed
// 16 bit immediate at [15:0]; the s_shli/s_shri/s_sari family instead take
// the shift amount in Mod, which is why those three still have an Arg2 field
// that reads as zero here.
//
0c3000ff // s_imm   s3, 0x00ff              s3 = 000000ff
1930abcd // s_immh  s3, 0xabcd              s3 = abcd00ff
0c40fffb // s_imm   s4, -5                  s4 = fffffffb
1a540003 // s_addi  s5,  s4, 3              -5 + 3      = fffffffe
1b64fffe // s_muli  s6,  s4, -2             -5 * -2     = 0000000a
1c73000f // s_andi  s7,  s3, 0x000f         abcd00ff & f = 0000000f
0d830f00 // s_ori   s8,  s3, 0x0f00         abcd00ff | f00 = abcd0fff
1d93ffff // s_xori  s9,  s3, -1             ~abcd00ff   = 5432ff00
0ea40004 // s_shli  s10, s4, 4              fffffffb << 4 = ffffffb0
0fb40004 // s_shri  s11, s4, 4              fffffffb >> 4 = 0fffffff
12c40004 // s_sari  s12, s4, 4              -5 >>> 4      = ffffffff
0cd00004 // s_imm   s13, 4
14e4d000 // s_shl   s14, s4, s13            fffffffb << 4 = ffffffb0
15f4d000 // s_shr   s15, s4, s13            fffffffb >> 4 = 0fffffff
b3000000 // s_endpgm

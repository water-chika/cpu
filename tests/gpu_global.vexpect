// gpu_global.s, one line per VGPR, lane 0 first (section 1.1: W = 16).
//
// Every word here is a function of an address and the data file's rule that
// the byte at address a holds a & 0xff, worked out by hand from section 4.8
// rather than copied out of a simulation:
//
//   v0   lane                       v1   lane * 4
//   v2   the word at 4 * lane       v3   the same word, asked for at +2
//   v4   the byte at 128 + lane, zero extended
//   v5   the same byte, sign extended (it is >= 0x80, so it is negative)
//   v6   lane * 16
//   v8..v11    bytes 256 + 16*lane + 4j .. +3, j = 0..3 (v_ld16_g)
//   v12..v15   the same quad asked for at +7, which section 4.8 truncates
//              back down to a multiple of 16
//
// v7 is untouched and must still read as the zero the wave launched with,
// which is what catches a load writing the wrong VGPR.
00000000 00000001 00000002 00000003 00000004 00000005 00000006 00000007 00000008 00000009 0000000a 0000000b 0000000c 0000000d 0000000e 0000000f // v0
00000000 00000004 00000008 0000000c 00000010 00000014 00000018 0000001c 00000020 00000024 00000028 0000002c 00000030 00000034 00000038 0000003c // v1

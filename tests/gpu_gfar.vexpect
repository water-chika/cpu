// v0 = lane id
00000000 00000001 00000002 00000003 00000004 00000005 00000006 00000007 00000008 00000009 0000000a 0000000b 0000000c 0000000d 0000000e 0000000f
// v1 = lane * 4, the per lane byte offset
00000000 00000004 00000008 0000000c 00000010 00000014 00000018 0000001c 00000020 00000024 00000028 0000002c 00000030 00000034 00000038 0000003c
// v2 = region A read back: the word at 0x60000 + 4*lane, which is 4*lane
00000000 00000004 00000008 0000000c 00000010 00000014 00000018 0000001c 00000020 00000024 00000028 0000002c 00000030 00000034 00000038 0000003c
// v3 = region B pattern, lane << 8
00000000 00000100 00000200 00000300 00000400 00000500 00000600 00000700 00000800 00000900 00000a00 00000b00 00000c00 00000d00 00000e00 00000f00
// v4 = region B read back.  v2 and v4 differ, so the regions did not alias
00000000 00000100 00000200 00000300 00000400 00000500 00000600 00000700 00000800 00000900 00000a00 00000b00 00000c00 00000d00 00000e00 00000f00

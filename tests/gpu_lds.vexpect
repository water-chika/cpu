// gpu_lds.s, all 256 VGPRs: sixteen lanes of v0, then sixteen of v1, and
// so on.
//
//   v0  lane
//   v1  lane * 4
//   v2  0x100 + lane, stored to LDS[0]
//   v3  the same, read back                     - the 4 byte round trip
//   v4  0xa0 + lane, stored one byte per lane
//   v5  the same, read back zero extended       - the 1 byte round trip
//   v6  lanes 0..3: the four bytes of their word, little-endian; lanes
//       4..15: the 0x5555 poison a masked load must not disturb
//   v7  0x5555, the background of the masked store
//   v8  0x1234, its payload
//   v9  0x1234 in lanes 0..7, 0x5555 in lanes 8..15
//   v10 0x100 + lane, out of the last sixteen words of the 8 KiB
//   v11 lane * 36, section 3.2's padded row stride
//   v12 0x100 + lane, out of the padded rows - where bank is not lane
//   v13 0x100 + lane, region 1 read again at the end - no aliasing
//   v14, v15 unused

00000000 00000001 00000002 00000003 00000004 00000005 00000006 00000007 00000008 00000009 0000000a 0000000b 0000000c 0000000d 0000000e 0000000f // v0
00000000 00000004 00000008 0000000c 00000010 00000014 00000018 0000001c 00000020 00000024 00000028 0000002c 00000030 00000034 00000038 0000003c // v1
00000100 00000101 00000102 00000103 00000104 00000105 00000106 00000107 00000108 00000109 0000010a 0000010b 0000010c 0000010d 0000010e 0000010f // v2
00000100 00000101 00000102 00000103 00000104 00000105 00000106 00000107 00000108 00000109 0000010a 0000010b 0000010c 0000010d 0000010e 0000010f // v3
000000a0 000000a1 000000a2 000000a3 000000a4 000000a5 000000a6 000000a7 000000a8 000000a9 000000aa 000000ab 000000ac 000000ad 000000ae 000000af // v4
000000a0 000000a1 000000a2 000000a3 000000a4 000000a5 000000a6 000000a7 000000a8 000000a9 000000aa 000000ab 000000ac 000000ad 000000ae 000000af // v5
